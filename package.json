{
  "name": "crazy-thursday-app",
  "version": "1.0.0",
  "private": true,
  "description": "Expression Feeding — a camera-driven feeding reaction game.",
  "author": "Crazy Thursday",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "node scripts/start.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test",
    "android:sync": "npm run build && cap sync android",
    "desktop": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac"
  },
  "dependencies": {"@capacitor/android": "8.5.3", "@capacitor/core": "8.5.3"},
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "engines": {"node": ">=22"},
  "build": {
    "appId": "com.crazythursday.app",
    "productName": "Expression Feeding",
    "files": ["www/**/*", "desktop/**/*"],
    "win": {"target": "nsis"},
    "mac": {"target": "dmg", "category": "public.app-category.games"}
  }
}
