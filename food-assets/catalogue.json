{
  "schemaVersion": 1,
  "purpose": "食物图片、中英双语台词与食物种类定义的唯一权威源。本目录是唯一可手工编辑的食物资源；npm run build 会自动校验并导出中英双语运行数据与打包图片。",
  "layout": {
    "catalogue.json": "本文件：中英双语条目 + categories 食物种类定义 + 接入规则",
    "png/<category>/": "全部食物图片，按种类分目录，文件名即条目 id",
    "generated": "src/food-catalogue.js（中英双语运行数据）与 www/（打包导出）均由 npm run build 自动生成，不要手工编辑",
    "addNew": "把新图放进对应种类子目录，在本文件 items 追加同 id 条目并同步更新该种类的 count；然后 npm run build 即可生效"
  },
  "pathRule": {
    "image": "png/<category>/<id>.png，相对本目录",
    "id": "小写 kebab-case，全局唯一，与 PNG 文件名（不含扩展名）一致",
    "addNew": "图片与条目都在同一个 food-assets/ 目录内维护；不要复用或改写已有 id。新增种类时同时建 png/ 子目录并在 categories 里登记 path/count/eatable/description。"
  },
  "fields": {
    "id": "稳定英文标识，对应游戏 ITEMS.id",
    "name": "英文名称，对应游戏 ITEMS.name",
    "name_zh": "中文名称，仅用于内容维护",
    "eatable": "true / false，对应游戏 ITEMS.eatable；当前无待定项。日后若判定未定，用 null 并标 status=review_required，不可当作 false",
    "status": "ready 可接入；review_required 表示判定待定（当前无此类条目）",
    "category": "food | foreign_object | lookalike | surreal_food，与 png/ 子目录一致",
    "line": "护士英文台词，对应游戏 ITEMS.line",
    "line_zh": "护士台词中文释义；风格与 54 包一致：短句、冷面、不解释，保留原文双关",
    "image": "相对本目录的图片路径，对应游戏 ITEMS.image",
    "sourcePack": "来源包：54 / 12 / cleanodd50，仅用于追溯",
    "sourceNumber": "原始包内编号，仅用于追溯"
  },
  "categories": {
    "food": {
      "path": "png/food/",
      "count": 26,
      "eatable": true,
      "description": "正常可食用"
    },
    "foreign_object": {
      "path": "png/foreign_object/",
      "count": 11,
      "eatable": false,
      "description": "明显异物 / 不可食用物品"
    },
    "lookalike": {
      "path": "png/lookalike/",
      "count": 46,
      "eatable": false,
      "description": "外形伪装成食物、实际不能吃"
    },
    "surreal_food": {
      "path": "png/surreal_food/",
      "count": 24,
      "eatable": true,
      "description": "猎奇组合食物，可食用；接受后大量加分、小幅增加不适；微笑接受或皱眉拒绝都保持连击，其他反应打断",
      "onAccept": {
        "score": "large_bonus",
        "discomfort": "small_penalty",
        "note": "相对量级；具体数值接入时在 src/logic.js 的 SCORING 中定义（现有基准：CORRECT_POINTS=10、DEFEND_DISCOMFORT=5、WRONG_EAT_DISCOMFORT=25）"
      }
    }
  },
  "notes": [
    "全部 PNG 为 768×768 RGBA 透明画布、物件居中；由总览图 AI 抠图生成，非逐像素无损。",
    "54 包编号 1–24 / 25–39 / 40–54 分别来自三张总览图；12 包是更早的另一批物件。",
    "原包的 CSV、台词 markdown、透明通道质检记录与深浅背景预览图均属制作期冗余，整合后移除。",
    "surreal_food 判定：可食用，接受后大量增加 score、小幅增加 discomfort。仅设 eatable=true 无法表达该效果，接入时需新增独立计分分支。",
    "12 包原始资料仅含英文台词，其 12 条中文释义为整理时补译，非原包自带。",
    "cleanodd50 包原含 50 条，按实际留存的 43 张 PNG 融入（缺编号 4/18/20/21/36/37/48）；全部归 lookalike、eatable=false。",
    "54 包编号 19（Six-sided die / 骰子）及其 PNG 已移除；foreign_object 由 12 条减为 11 条。",
    "cleanodd50 编号 11（Dice Cheese / 骰子芝士）及其 PNG 已移除；lookalike 由 47 条减为 46 条，cleanodd50 现存 42 条。",
    "食物资源统一收在 food-assets/ 一个目录：图片、中英双语条目与种类定义都在这里；src/ 与 www/ 下只有自动生成的导出副本，不再保留可编辑的重复版本。"
  ],
  "integration": {
    "step": "已接入。改本清单后运行 npm run build（或 npm start，它会自动构建）：先校验本目录的图片/种类/中英文字段，重新生成含 name_zh/line_zh 的 src/food-catalogue.js，再把 png/<category>/ 展平导出到 www/assets/food/<id>.png。src/logic.js 的 ITEMS 由 src/food-catalogue.js 导出。npm run food:sync 只做校验与生成运行数据，不导出图片。",
    "singleSource": "food-assets/ 是唯一可编辑的食物资源目录；src/ 里只有自动生成的中英双语运行数据，www/ 只是打包导出副本（已 gitignore）。三处都不需要手工同步。",
    "chinese": "name_zh / line_zh 随 name / line 一起写入生成的 src/food-catalogue.js 与 www/food-catalogue.js，供之后全局语言切换提取。当前界面仍读 name / line 保持英文；统一提取入口是 foodText(item, language) 与 FOOD_LOCALES（en / zh，与调试界面语言码一致），未知语言回退英文。",
    "surrealFood": "已在 src/logic.js 实现：接受返回 SURREAL_ACCEPT（SURREAL_POINTS=30、SURREAL_DISCOMFORT=5，不触发催吐补救）；拒绝返回 SURREAL_REJECT（0 分 / 0 不适，不加速）。两者都通过 comboContinues 保持连击，无反应与闭眼防御会打断。数值可调。"
  },
